{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock", "custom/khal", "custom/recorder"],
  "modules-right": [
    "idle_inhibitor",
    "hyprland/language",
    "pulseaudio",
    "network",
    "battery",
    "tray",
    "custom/control-center",
    "custom/keybinds"
  ],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{id}"
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %B %d, %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

"custom/khal": {
    "exec": "~/.config/waybar/scripts/khal-waybar.py",
    "return-type": "json",
    "interval": 300,
    "on-click": "foot --title='Calendar' --app-id='ikhal' -e ikhal",
    "on-click-right": "~/.config/waybar/scripts/khal-notify.fish",
    "tooltip": true
},

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },

  "hyprland/language": {
    "format": "  {}",
    "format-en": "EN",
    "format-ar": "AR",
    "on-click": "hyprctl switchxkblayout $(hyprctl devices -j | jq -r '.keyboards[] | select(.main==true) | .name') next"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "",
    "format-alt": "{capacity}% {icon}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{capacity}% - {time} left"
  },

  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "on-click": "foot -e nmtui"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰖁",
    "format-icons": { "default": ["", "", ""] },
    "on-click": "foot -e pulsemixer",
    "on-click-right": "pavucontrol"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  },

  "custom/control-center": {
    "format": "",
    "tooltip-format": "Control Center (notifications, DND, brightness, volume, updates, dotfiles, mic)",
    "on-click": "~/.config/swaync/scripts/refresh-panel.sh"
  },

  "custom/recorder": {
    "exec": "echo '{\"text\": \"⏺ REC\", \"class\": \"recording\"}'",
    "exec-if": "pgrep wf-recorder",
    "return-type": "json",
    "interval": 2,
    "tooltip": false
},

  "custom/keybinds": {
    "format": "󰌌",
    "tooltip-format": "Show all Hyprland keybinds (SUPER + /)",
    "on-click": "~/.local/bin/keybind-cheatsheet.sh"
  },
}
