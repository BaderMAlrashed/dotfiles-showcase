# ---------------------------------
# MAKO — MODERN HYPRLAND STYLE
# ---------------------------------

font=JetBrainsMono Nerd Font Medium 11

background-color=#16161dee
text-color=#c0caf5

border-color=#7aa2f7cc
border-size=1
border-radius=16

padding=16
margin=16
outer-margin=12

width=360

icons=1
max-icon-size=48
icon-path=/usr/share/icons/Papirus-Dark

max-visible=4

anchor=top-right
layer=overlay

default-timeout=5000
ignore-timeout=0

sort=-time

group-by=summary

markup=1

format=<span weight="bold" size="115%%">%s</span>\n%b

text-alignment=left

on-button-left=dismiss
on-button-right=dismiss-all
on-touch=dismiss
